# Configurações Gerais
TZ=America/Sao_Paulo
PUID=1000
PGID=1000

# Domínio e Certificados
DOMAIN_NAME=teudominio.com
ADMIN_EMAIL=teu-email@exemplo.com

# Credenciais de administrador (mesma senha em todos os serviços)
# Aplicada por docker-compose (NPM, code-server) e por scripts/sync-admin-password.sh
# (Portainer, Filebrowser, Syncthing, qBittorrent, Jellyfin, Uptime Kuma, Crafty).
# Mínimo 12 caracteres. Evite aspas e espaços; o .env é lido pelo shell.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-forte
NPM_ADMIN_EMAIL=admin@example.com

# Caminhos de Armazenamento
DATA_DIR=./services
MEDIA_DIR=/mnt/dados/media # Altere para o caminho do seu disco/pasta de mídias
